{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PersonalWorkstation",
  "version": "0.9.0",
  "identifier": "com.personal.workstation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "个人工作台",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      },
      {
        "label": "quick",
        "create": false,
        "url": "quick.html",
        "title": "快速面板",
        "width": 560,
        "height": 380,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
